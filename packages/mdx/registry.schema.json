{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sao-blog MDX component registry",
  "components": {
    "Alert": {
      "description": "提示框",
      "children": true,
      "translatableProps": [
        "title"
      ],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "note",
              "info",
              "success",
              "warning",
              "danger"
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "Accordion": {
      "description": "折疊面板容器，子元素為 AccordionItem",
      "children": true,
      "translatableProps": [],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "multiple": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "AccordionItem": {
      "description": "單一折疊項",
      "children": true,
      "translatableProps": [
        "title"
      ],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "open": {
            "type": "boolean"
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    },
    "Tabs": {
      "description": "分頁容器，子元素為 Tab",
      "children": true,
      "translatableProps": [],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "defaultIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false
      }
    },
    "Tab": {
      "description": "單一分頁",
      "children": true,
      "translatableProps": [
        "label"
      ],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      }
    },
    "Carousel": {
      "description": "輪播容器，子元素為 Slide",
      "children": true,
      "translatableProps": [],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "loop": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "Slide": {
      "description": "單張輪播內容",
      "children": true,
      "translatableProps": [],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "Progress": {
      "description": "進度條",
      "children": false,
      "translatableProps": [
        "label"
      ],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "enum": [
              "blue",
              "green",
              "amber",
              "red",
              "purple",
              "pink"
            ]
          },
          "showValue": {
            "type": "boolean"
          }
        },
        "required": [
          "value"
        ],
        "additionalProperties": false
      }
    },
    "Benchmark": {
      "description": "效能比較長條圖，子元素為 BenchmarkItem",
      "children": true,
      "translatableProps": [],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "lowerIsBetter": {
            "type": "boolean"
          },
          "unit": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "BenchmarkItem": {
      "description": "單一比較項",
      "children": false,
      "translatableProps": [
        "label"
      ],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "enum": [
              "blue",
              "green",
              "amber",
              "red",
              "purple",
              "pink"
            ]
          },
          "highlight": {
            "type": "boolean"
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "CustomQuote": {
      "description": "引言",
      "children": true,
      "translatableProps": [],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "variant": {
            "type": "string",
            "enum": [
              "default",
              "warning",
              "info",
              "success"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "Count": {
      "description": "計數器示範元件",
      "children": false,
      "translatableProps": [],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  }
}
