{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "admin", "run", "dev"],
      "port": 3003
    },
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "server", "run", "dev"],
      "port": 3000
    },
    {
      "name": "tan-blog",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "tan-blog", "run", "dev"],
      "port": 3004
    },
    {
      "name": "tan-blog-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": ["apps/tan-blog/.output/server/index.mjs"],
      "env": { "PORT": "3014", "REVALIDATE_SECRET": "local-prod-preview-secret" },
      "port": 3014
    }
  ]
}
